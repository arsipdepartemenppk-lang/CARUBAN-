{
  "entities": {
    "PK": {
      "title": "PK",
      "description": "Data Master PK",
      "type": "object",
      "properties": {
        "idPK": { "type": "string" },
        "namaPK": { "type": "string" },
        "alamat": { "type": "string" },
        "kecamatan": { "type": "string" },
        "zona": { "type": "string" },
        "koorzon": { "type": "string" },
        "namaKetua": { "type": "string" },
        "noHp": { "type": "string" },
        "status": { "type": "string", "enum": ["Aktif", "Non Aktif", "Vakum"] },
        "organisasi": { "type": "string", "enum": ["IPNU", "IPPNU"] },
        "logoUrl": { "type": "string", "format": "uri" },
        "excellentRating": { "type": "number", "description": "Rata-rata skor visitasi" },
        "lat": { "type": "number" },
        "lng": { "type": "number" }
      },
      "required": ["idPK", "namaPK", "kecamatan", "zona", "status", "organisasi"]
    },
    "Member": {
      "title": "Member",
      "description": "Data Anggota & Kader",
      "type": "object",
      "properties": {
        "namaLengkap": { "type": "string" },
        "nomorIndukAnggota": { "type": "string" },
        "noHp": { "type": "string" },
        "email": { "type": "string" },
        "namaSekolah": { "type": "string" },
        "alamatSekolah": { "type": "string" },
        "alamatLengkap": { "type": "string" },
        "statusPimpinan": { "type": "string", "enum": ["PAC", "PR", "PK", "PC", "Anggota"] },
        "kelasTingkat": { "type": "string" },
        "tanggalLahir": { "type": "string" },
        "minatBakat": { "type": "array", "items": { "type": "string" } },
        "foto": { "type": "string" },
        "fotoUrl": { "type": "string" },
        "lat": { "type": "number" },
        "lng": { "type": "number" },
        "statusKeanggotaan": { "type": "string", "enum": ["Aktif", "Alumni", "Pengurus"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "createdBy": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "updatedBy": { "type": "string" }
      },
      "required": ["namaLengkap", "nomorIndukAnggota", "statusPimpinan"]
    },
    "Visitasi": {
      "title": "Visitasi",
      "description": "Data Visitasi CORE",
      "type": "object",
      "properties": {
        "tanggalVisitasi": { "type": "string", "format": "date-time" },
        "idPK": { "type": "string" },
        "targetLembaga": { "type": "string" },
        "zona": { "type": "string" },
        "waktu": { "type": "string" },
        "status": { "type": "string", "enum": ["Terjadwal", "Selesai", "Tertunda"] },
        "timVisitasi": { "type": "array", "items": { "type": "string" } },
        "skorAdministrasi": { "type": "number" },
        "skorKaderisasi": { "type": "number" },
        "skorKeuangan": { "type": "number" },
        "skorInovasi": { "type": "number" },
        "catatanKaderisasi": { "type": "string" },
        "catatanAdministrasi": { "type": "string" },
        "rekomendasi": { "type": "string" },
        "dokumentasiUrl": { "type": "string" }
      },
      "required": ["tanggalVisitasi", "idPK", "targetLembaga", "status"]
    },
    "Agenda": {
      "title": "Agenda",
      "description": "Buku Agenda Digital",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "category": { "type": "string" },
        "date": { "type": "string" },
        "time": { "type": "string" },
        "location": { "type": "string" },
        "description": { "type": "string" },
        "organizer": { "type": "string" },
        "targetParticipants": { "type": "string" },
        "status": { "type": "string", "enum": ["Akan Datang", "Berlangsung", "Selesai"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "createdBy": { "type": "string" }
      },
      "required": ["title", "date", "location"]
    },
    "Attendance": {
      "title": "Attendance",
      "description": "Record presensi kegiatan",
      "type": "object",
      "properties": {
        "meetingId": { "type": "string" },
        "meetingTitle": { "type": "string" },
        "memberId": { "type": "string" },
        "memberName": { "type": "string" },
        "memberNia": { "type": "string" },
        "memberSekolah": { "type": "string" },
        "memberPimpinan": { "type": "string" },
        "isGuest": { "type": "boolean" },
        "guestOrigin": { "type": "string", "description": "Asal instansi/organisasi tamu" },
        "status": { "type": "string", "enum": ["Hadir", "Terlambat", "Izin"] },
        "scannedAt": { "type": "string", "format": "date-time" },
        "scannedBy": { "type": "string" }
      },
      "required": ["meetingId", "memberName", "status", "scannedAt"]
    },
    "User": {
      "title": "User",
      "description": "Data User Profile",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "developer", "PC", "PAC", "PK", "PR", "Anggota", "Pengurus", "user"] },
        "poinSkill": { "type": "number" },
        "completedMateri": { "type": "array", "items": { "type": "string" } },
        "googleCalendarTokens": { "type": "object" },
        "fcmToken": { "type": "string" },
        "lastTokenUpdate": { "type": "string", "format": "date-time" },
        "passwordLastChanged": { "type": "string", "format": "date-time", "description": "Timestamp terakhir kali password akun diperbarui" }
      },
      "required": ["role"]
    }
  },
  "firestore": {
    "/security_audit_logs/{id}": { "schema": "object", "description": "Log audit akses sensitif terenkripsi AES-256 dan HMAC-SHA256" },
    "/pks/{pkId}": { "schema": "PK", "description": "Koleksi data PK" },
    "/visitasis/{visitasiId}": { "schema": "Visitasi", "description": "Koleksi data Visitasi CORE" },
    "/materi/{materiId}": { "schema": "object", "description": "Koleksi materi belajar" },
    "/kas_transaksi/{id}": { "schema": "object", "description": "Koleksi transaksi kas" },
    "/kas_inventaris/{id}": { "schema": "object", "description": "Koleksi inventaris kas" },
    "/users/{userId}": { "schema": "User", "description": "Koleksi data User" },
    "/user_status/{userId}": { "schema": "object", "description": "Status online user" },
    "/presence/{userId}": { "schema": "object", "description": "Status kehadiran realtime" },
    "/members/{memberId}": { "schema": "Member", "description": "Koleksi data Anggota" },
    "/pimpinan/{id}": { "schema": "object", "description": "Database Pimpinan PAC/PR/PK" },
    "/internal_posts/{postId}": { "schema": "object", "description": "Koleksi postingan internal" },
    "/stories/{storyId}": { "schema": "object", "description": "Koleksi cerita/story" },
    "/suratMasuk/{suratId}": { "schema": "object", "description": "Koleksi Surat Masuk" },
    "/suratKeluar/{suratId}": { "schema": "object", "description": "Koleksi Surat Keluar" },
    "/agendas/{agendaId}": { "schema": "Agenda", "description": "Buku Agenda Digital" },
    "/activity_logs/{id}": { "schema": "object", "description": "Log aktivitas sistem" },
    "/attendances/{id}": { "schema": "Attendance", "description": "Record presensi" },
    "/chats/{id}": { "schema": "object", "description": "Koleksi pesan chat" },
    "/chat_rooms/{roomId}": { "schema": "object", "description": "Koleksi grup chat" },
    "/followers/{id}": { "schema": "object", "description": "Koleksi data pengikut" },
    "/typing/{id}": { "schema": "object", "description": "Status sedang mengetik" },
    "/kaderisasi/{id}": { "schema": "object", "description": "Modul pengembangan kader" },
    "/beasiswa/{id}": { "schema": "object", "description": "Data program beasiswa" },
    "/templates/{id}": { "schema": "object", "description": "Template surat & dokumen" },
    "/notifications/{id}": { "schema": "object", "description": "Notifikasi user" },
    "/global_notifications/{id}": { "schema": "object", "description": "Notifikasi global" },
    "/kunjungan/{id}": { "schema": "object", "description": "Catatan kunjungan lapangan" },
    "/core_evaluations/{id}": { "schema": "object", "description": "Evaluasi modul CORE" },
    "/arsip_digital/{id}": { "schema": "object", "description": "Arsip digital organisasi" },
    "/media_storage/{id}": { "schema": "object", "description": "Penyimpanan data foto dan video dokumentasi" }
  }
}
