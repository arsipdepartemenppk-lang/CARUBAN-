rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Default Deny - Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // ===============================================================
    // Global Authentication & Tiered RBAC Helpers
    // ===============================================================
    function isSignedIn() {
      return request.auth != null;
    }
    
    // Strict System Administrator Whitelist (No loose regex matching)
    function isSystemAdmin() {
      return isSignedIn() && (
        request.auth.token.email == "arsipdepartemenppk@gmail.com" ||
        request.auth.token.email == "arsipdepartemenpendidikan@gmail.com" ||
        request.auth.token.email == "syifaudina15@gmail.com"
      );
    }

    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    // Tier 1: System Admin & Developer
    function isAdmin() {
      return isSystemAdmin() || (
        isSignedIn() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
        (getUserRole() == 'admin' || getUserRole() == 'developer')
      );
    }

    // Tier 2: Pimpinan Cabang (PC)
    function isPC() {
      return isAdmin() || (
        isSignedIn() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
        getUserRole() == 'PC'
      );
    }

    // Tier 3: Pimpinan Anak Cabang (PAC - Kecamatan)
    function isPAC() {
      return isPC() || (
        isSignedIn() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
        getUserRole() == 'PAC'
      );
    }

    // Tier 4: Pimpinan Komisariat (PK - Sekolah/Madrasah/Pesantren)
    function isPK() {
      return isPAC() || (
        isSignedIn() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
        getUserRole() == 'PK'
      );
    }

    // Tier 5: Pimpinan Ranting (PR - Desa/Kelurahan)
    function isPR() {
      return isPK() || (
        isSignedIn() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
        getUserRole() == 'PR'
      );
    }

    // Tier 6: Pengurus Terdaftar
    function isPengurus() {
      return isPR() || (
        isSignedIn() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
        getUserRole() == 'Pengurus'
      );
    }

    // ===============================================================
    // Collection Rules & Data Integrity
    // ===============================================================

    // User Profiles: Strict Anti-Privilege Escalation
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isPC());
      allow list: if isAdmin() || isPC();
      
      // Prevent Self-Assigned Role: Users cannot assign themselves admin/PC on creation
      allow create: if isSignedIn() && request.auth.uid == userId && (
        isSystemAdmin() || 
        (!('role' in request.resource.data) || request.resource.data.role == 'user' || request.resource.data.role == 'Anggota')
      );
      
      // Prevent Role Tampering on Update: Users cannot change their own role field
      allow update: if isSignedIn() && (
        isAdmin() || 
        (request.auth.uid == userId && 
         request.resource.data.diff(resource.data).affectedKeys().hasOnly([
           'poinSkill', 'completedMateri', 'nama', 'displayName', 'email', 'photoURL', 
           'lastLogin', 'notificationSettings', 'notificationPreferences', 'phoneNumber', 
           'googleCalendarTokens', 'fcmToken', 'lastTokenUpdate', 'uid', 'isAnonymous', 'updatedAt', 'passwordLastChanged'
         ]) &&
         (!('role' in request.resource.data) || request.resource.data.role == resource.data.role))
      );
      
      allow delete: if isAdmin();
      
      match /kader_logs/{logId} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }
    }

    // Status & Presence
    match /user_status/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == userId;
    }
    match /presence/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == userId;
    }
    match /typing/{id} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.resource.data.uid == request.auth.uid;
    }

    // Data Anggota & Kader: Tiered access protection
    match /members/{memberId} {
      allow read: if isSignedIn();
      // Only Pengurus or the member creating/updating their own entry can modify
      allow create: if isSignedIn() && (
        isPengurus() || 
        request.resource.data.createdBy == request.auth.uid
      );
      allow update: if isSignedIn() && (
        isPengurus() || 
        resource.data.createdBy == request.auth.uid
      );
      allow delete: if isPC();
    }

    // Master PK, Pimpinan, and Visitasi: Managed by PC/Admin
    match /pks/{pkId} {
      allow read: if isSignedIn();
      allow create, update: if isPC();
      allow delete: if isAdmin();
    }
    match /pimpinan/{pimpinanId} {
      allow read: if isSignedIn();
      allow create, update: if isPC();
      allow delete: if isAdmin();
    }
    match /visitasis/{visitasiId} {
      allow read: if isSignedIn();
      allow create, update: if isPC();
      allow delete: if isAdmin();
    }

    // Documents & Correspondence
    match /suratMasuk/{suratId} {
      allow read: if isSignedIn();
      allow create, update: if isPR();
      allow delete: if isAdmin();
    }
    match /suratKeluar/{suratId} {
      allow read: if isSignedIn();
      allow create, update: if isPR();
      allow delete: if isAdmin();
    }
    match /templates/{id} {
      allow read: if isSignedIn();
      allow write: if isPR();
    }

    // Financial Ledgers: Protected from regular members
    match /kas_transaksi/{id} {
      allow read: if isPC();
      allow create: if isPC();
      allow update, delete: if isAdmin();
    }
    match /kas_inventaris/{id} {
      allow read: if isPK();
      allow write: if isPC();
    }

    // Digital Archives & Media
    match /arsip_digital/{id} {
      allow read: if isSignedIn();
      allow create: if isPR();
      allow update, delete: if isAdmin();
    }
    match /media_storage/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && (resource.data.uploadedBy == request.auth.uid || isAdmin());
    }

    // Agendas & Attendances
    match /agendas/{id} {
      allow read: if true; // Public for event attendees
      allow write: if isPR();
    }
    match /attendances/{id} {
      allow read: if isSignedIn();
      // Validate attendance payload structure to prevent Denial of Wallet spam
      allow create: if request.resource.data.meetingId is string && 
                       request.resource.data.memberName is string && 
                       request.resource.data.size() <= 20;
      allow update, delete: if isAdmin();
    }

    // Activities & Monitoring
    match /activity_logs/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
    }
    // High-Security Encrypted Audit Trail (AES-256 + HMAC-SHA256)
    match /security_audit_logs/{id} {
      allow read: if isAdmin();
      allow create: if isSignedIn() || (
        request.resource.data.cipherPayload is string &&
        request.resource.data.integrityHash is string &&
        request.resource.data.isEncrypted == true &&
        request.resource.data.action in ['FAILED_LOGIN_ATTEMPT', 'BRUTE_FORCE_ATTACK_DETECTED', 'LOGIN_BLOCKED']
      );
      allow update, delete: if false; // strictly immutable audit trail
    }
    match /activities/{id} {
      allow read, write: if isSignedIn();
    }
    match /visitations/{id} {
      allow read, write: if isPC();
    }
    match /kunjungan/{id} {
      allow read: if isSignedIn();
      allow write: if isPC();
    }
    match /core_evaluations/{id} {
      allow read: if isSignedIn();
      allow write: if isPK();
    }

    // Learning, Curriculum, & Resources
    match /materi/{id} {
      allow read: if isSignedIn();
      allow write: if isPC();
    }
    match /kaderisasi/{id} {
      allow read: if isSignedIn();
      allow write: if isPC();
    }
    match /beasiswa/{id} {
      allow read: if isSignedIn();
      allow write: if isPC();
    }

    // Social, Community, & Communication
    match /internal_posts/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.authorUid == request.auth.uid;
      allow update: if isSignedIn() && (
        (resource.data.authorUid == request.auth.uid) ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'comments', 'upvotes', 'downvotes']))
      );
      allow delete: if isAdmin() || (isSignedIn() && resource.data.authorUid == request.auth.uid);
    }
    match /stories/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.authorUid == request.auth.uid;
      allow update: if isSignedIn() && (resource.data.authorUid == request.auth.uid || isAdmin());
      allow delete: if isAdmin() || (isSignedIn() && resource.data.authorUid == request.auth.uid);
    }
    match /chat_rooms/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (request.auth.uid in resource.data.members || isAdmin());
      allow delete: if isAdmin();
    }
    match /chats/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.senderId == request.auth.uid;
      allow delete: if isAdmin() || (isSignedIn() && resource.data.senderId == request.auth.uid);
    }
    match /followers/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.followerId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.followerId == request.auth.uid;
    }

    // Notifications
    match /notifications/{id} {
      allow read, write: if isSignedIn();
    }
    match /global_notifications/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
